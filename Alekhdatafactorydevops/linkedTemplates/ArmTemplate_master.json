{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "Alekhdatafactorydevops"
		},
		"localonpremfiles_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'localonpremfiles'"
		},
		"lsdatalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'lsdatalake'"
		},
		"localonpremfiles_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Alekh-ADFDevopsproj raw files"
		},
		"localonpremfiles_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "alekhtri9@outlook.com"
		},
		"lsdatalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://alekhadfstorage.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "Alekhdatafactorydevops_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"lsdatalake_accountKey": {
						"value": "[parameters('lsdatalake_accountKey')]"
					},
					"localonpremfiles_password": {
						"value": "[parameters('localonpremfiles_password')]"
					},
					"lsdatalake_properties_typeProperties_url": {
						"value": "[parameters('lsdatalake_properties_typeProperties_url')]"
					},
					"localonpremfiles_properties_typeProperties_host": {
						"value": "[parameters('localonpremfiles_properties_typeProperties_host')]"
					},
					"localonpremfiles_properties_typeProperties_userId": {
						"value": "[parameters('localonpremfiles_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}